# ===========================================
# Bella Casa HMS - .gitignore
# ===========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Environment files - NEVER commit secrets
.env
.env.development
.env.test
.env.staging
.env.production
.env.local
*.env

# Keep the example file
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# TypeScript build info
*.tsbuildinfo

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Prisma
packages/database/node_modules/
# Keep migrations, not generated client
packages/database/src/generated/

# Test artifacts
test-results/
playwright-report/

# Temporary
tmp/
temp/
*.tmp
