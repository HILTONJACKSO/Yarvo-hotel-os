# =============================================================================
# Bella Casa Hotel Management System — Environment Variables Template
# =============================================================================
# Copy this file to .env.development for local development
# NEVER commit actual .env files. Only commit .env.example.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Bella Casa HMS"

# ─── API Server ───────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME="Bella Casa Hotel"
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL 18) ─────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://bellacasa:CHANGE_ME@127.0.0.1:5433/bellacasa
DATABASE_URL_TEST=postgresql://bellacasa:CHANGE_ME@127.0.0.1:5433/bellacasa_test

# ─── Authentication ───────────────────────────────────────────────────────────
# MUST be at least 32 random characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session cookie security
COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=localhost

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=900000
AUTH_RATE_LIMIT_MAX=10

# ─── Redis (deferred — not required in Phase 1) ───────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── File Storage (Phase 11+) ────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=

# ─── Email (Phase 18+) ────────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Bella Casa Hotel <noreply@bellacasa.com>"

# ─── WhatsApp (Phase 18+) ─────────────────────────────────────────────────────
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_ID=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── Swagger/API Docs ─────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ─── Hotel Configuration (set via admin UI in Phase 4) ───────────────────────
# DEFAULT_CURRENCY_PRIMARY=USD
# DEFAULT_CURRENCY_SECONDARY=LRD
# DEFAULT_TIMEZONE=Africa/Monrovia
