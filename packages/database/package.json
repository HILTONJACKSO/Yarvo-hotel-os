{
  "name": "@bellacasa/database",
  "version": "1.0.0",
  "private": true,
  "description": "Bella Casa HMS - Prisma database schema and migrations",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:test": "DATABASE_URL=%DATABASE_URL_TEST% prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "argon2": "^0.45.1",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
